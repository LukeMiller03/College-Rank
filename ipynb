

import pandas as pd

df = pd.read_csv("../data/college_rankings_raptor2.csv")

print(df.head())

print(df.info())

df['Scaled Score Cleaned'] = df['Scaled Score'].str.extract(r'([\d.]+)').astype(float)


df['Rank Change'] = df['Prior Rank'] - df['Rank']


top_gainers = df.sort_values(by='Rank Change', ascending=False).head(10)
print(top_gainers[['School Name', 'Rank Change']])
